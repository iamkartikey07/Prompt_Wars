# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -eu

find_java_home() {
    if [ -n "${JAVA_HOME:-}" ]; then
        return
    fi
    if [ -x /usr/libexec/java_home ]; then
        JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null || true)
        export JAVA_HOME
    fi
}

find_java_home

if [ -z "${JAVA_HOME:-}" ]; then
    echo "Error: JAVA_HOME is not set and no 'java' command found in PATH." >&2
    exit 1
fi

JAVA_CMD="${JAVA_HOME}/bin/java"

# Locate the wrapper jar
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_WRAPPER_PROPERTIES="${SCRIPT_DIR}/.mvn/wrapper/maven-wrapper.properties"

# Read the distribution URL from properties
DISTRIBUTION_URL=""
if [ -f "${MAVEN_WRAPPER_PROPERTIES}" ]; then
    DISTRIBUTION_URL=$(grep "^distributionUrl=" "${MAVEN_WRAPPER_PROPERTIES}" | cut -d'=' -f2-)
fi

if [ -z "${DISTRIBUTION_URL}" ]; then
    DISTRIBUTION_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip"
fi

# Determine local cache directory
MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_CACHE="${MAVEN_USER_HOME}/wrapper/dists"

# Derive distribution name and path
DIST_FILENAME=$(basename "${DISTRIBUTION_URL}")
DIST_NAME="${DIST_FILENAME%-bin.zip}"
DIST_DIR="${MAVEN_CACHE}/${DIST_NAME}"
MAVEN_HOME="${DIST_DIR}/apache-maven-${DIST_NAME##apache-maven-}"

# Use already-extracted Maven if present
if [ -d "${MAVEN_HOME}" ] && [ -f "${MAVEN_HOME}/bin/mvn" ]; then
    exec "${MAVEN_HOME}/bin/mvn" "$@"
fi

# Otherwise download and extract
mkdir -p "${DIST_DIR}"
ZIP_FILE="${DIST_DIR}/${DIST_FILENAME}"

if [ ! -f "${ZIP_FILE}" ]; then
    echo "Downloading Apache Maven from ${DISTRIBUTION_URL}..."
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "${ZIP_FILE}" "${DISTRIBUTION_URL}"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "${ZIP_FILE}" "${DISTRIBUTION_URL}"
    else
        echo "Error: neither curl nor wget is available." >&2
        exit 1
    fi
fi

echo "Extracting Maven..."
unzip -q "${ZIP_FILE}" -d "${DIST_DIR}"

exec "${MAVEN_HOME}/bin/mvn" "$@"
